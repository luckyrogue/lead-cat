  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["postgres", "redis", "bot_ok", "version"],
        "properties": {
          "postgres": { "type": "string", "enum": ["ok", "down"] },
          "redis": { "type": "string", "enum": ["ok", "down"] },
          "bot_ok": { "type": "boolean" },
          "version": { "type": "string" }
        }
      },
      "TmaAuthRequest": {
        "type": "object",
        "required": ["init_data"],
        "properties": {
          "init_data": { "type": "string" }
        }
      },
      "TmaUser": {
        "type": "object",
        "required": ["telegram_id", "name", "email", "role"],
        "properties": {
          "telegram_id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["user", "admin"] }
        }
      },
      "TmaAuthResponse": {
        "type": "object",
        "required": ["token", "user"],
        "properties": {
          "token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/TmaUser" }
        }
      },
      "TmaAuthError": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["not_registered", "invalid_init_data"]
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "TmaMeeting": {
        "type": "object",
        "required": [
          "id",
          "type",
          "dept",
          "host",
          "date",
          "start",
          "end",
          "rec",
          "organizer",
          "participants",
          "desc",
          "meet_link",
          "status"
        ],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "dept": { "type": "string" },
          "host": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "rec": { "type": "string" },
          "organizer": { "type": "string", "format": "email" },
          "participants": {
            "type": "array",
            "items": { "type": "string", "format": "email" }
          },
          "desc": { "type": "string" },
          "meet_link": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "TmaMeetingsResponse": {
        "type": "object",
        "required": ["meetings"],
        "properties": {
          "meetings": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TmaMeeting" }
          }
        }
      },
      "TmaEmployee": {
        "type": "object",
        "required": ["id", "name", "email", "dept", "tg"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "dept": { "type": "string" },
          "tg": { "type": "boolean" }
        }
      },
      "TmaEmployeesResponse": {
        "type": "object",
        "required": ["employees"],
        "properties": {
          "employees": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TmaEmployee" }
          }
        }
      },
      "TmaFreeSlotsRequest": {
        "type": "object",
        "required": ["participants", "from", "to", "duration_mins"],
        "properties": {
          "participants": {
            "type": "array",
            "items": { "type": "string", "format": "email" }
          },
          "from": { "type": "string", "format": "date" },
          "to": { "type": "string", "format": "date" },
          "duration_mins": { "type": "integer", "minimum": 1 }
        }
      },
      "TmaFreeSlot": {
        "type": "object",
        "required": ["iso", "start", "end", "mins"],
        "properties": {
          "iso": { "type": "string", "format": "date" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "mins": { "type": "integer" }
        }
      },
      "TmaFreeSlotsResponse": {
        "type": "object",
        "required": ["slots"],
        "properties": {
          "slots": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TmaFreeSlot" }
          }
        }
      },
      "TmaMeetingUpdateRequest": {
        "type": "object",
        "properties": {
          "dept":  { "type": "string", "nullable": true },
          "type":  { "type": "string", "nullable": true },
          "host":  { "type": "string", "nullable": true },
          "date":  { "type": "string", "nullable": true, "description": "YYYY-MM-DD" },
          "start": { "type": "string", "nullable": true, "description": "HH:MM" },
          "end":   { "type": "string", "nullable": true, "description": "HH:MM" },
          "desc":  { "type": "string", "nullable": true }
        }
      },
      "TmaConflictsRequest": {
        "type": "object",
        "required": ["participants", "date", "start", "end"],
        "properties": {
          "participants": { "type": "array", "items": { "type": "string", "format": "email" } },
          "date":  { "type": "string", "description": "YYYY-MM-DD" },
          "start": { "type": "string", "description": "HH:MM Almaty" },
          "end":   { "type": "string", "description": "HH:MM Almaty" },
          "exclude_id": { "type": "string", "format": "uuid" },
          "recurrence": { "type": "string", "enum": ["once", "daily", "weekly", "custom", "monthly"] },
          "recurrence_until": { "type": "string", "format": "date" },
          "recurrence_days": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 7 }
          }
        }
      },
      "TmaConflict": {
        "type": "object",
        "required": ["email", "name", "title", "start", "end"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "name":  { "type": "string" },
          "title": { "type": "string" },
          "start": { "type": "string", "description": "HH:MM Almaty" },
          "end":   { "type": "string", "description": "HH:MM Almaty" }
        }
      },
      "TmaOccurrenceConflicts": {
        "type": "object",
        "required": ["date", "start", "end", "conflicts"],
        "properties": {
          "date":  { "type": "string", "format": "date" },
          "start": { "type": "string", "example": "10:00" },
          "end":   { "type": "string", "example": "11:00" },
          "conflicts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TmaConflict" }
          }
        }
      },
      "TmaAdminWorkspaceStatus": {
        "type": "object",
        "required": ["id", "name", "tz", "meet_link", "has_google", "google_subject", "google_calendar_id", "has_chat"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "tz": { "type": "string" },
          "meet_link": { "type": "string" },
          "has_google": { "type": "boolean" },
          "google_subject": { "type": "string" },
          "google_calendar_id": { "type": "string" },
          "has_chat": { "type": "boolean" },
          "chat_id": { "type": "integer", "format": "int64" },
          "chat_title": { "type": "string" }
        }
      },
      "TmaAdminIntegrationsView": {
        "type": "object",
        "required": ["has_google", "google_subject", "google_calendar_id", "meet_link", "tz"],
        "properties": {
          "has_google": { "type": "boolean" },
          "google_subject": { "type": "string" },
          "google_calendar_id": { "type": "string" },
          "meet_link": { "type": "string" },
          "tz": { "type": "string" }
        }
      },
      "TmaAdminIntegrationsPatchRequest": {
        "type": "object",
        "properties": {
          "google_sa_json": { "type": "string" },
          "google_subject": { "type": "string" },
          "google_calendar_id": { "type": "string" },
          "meet_link": { "type": "string" },
          "tz": { "type": "string" }
        }
      },
      "TmaAdminGoogleVerifyResult": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean" },
          "calendar_summary": { "type": "string" },
          "time_zone": { "type": "string" },
          "access_role": { "type": "string" }
        }
      },
      "TmaAdminChatStatus": {
        "type": "object",
        "required": ["linked"],
        "properties": {
          "linked": { "type": "boolean" },
          "chat_id": { "type": "integer", "format": "int64" },
          "chat_title": { "type": "string" }
        }
      },
      "TmaAdminChatLinkRequest": {
        "type": "object",
        "required": ["chat_id"],
        "properties": {
          "chat_id": { "type": "integer", "format": "int64" },
          "chat_title": { "type": "string" }
        }
      },
      "TmaAdminMember": {
        "type": "object",
        "required": ["id", "full_name", "telegram_username", "role"],
        "properties": {
          "id": { "type": "string" },
          "full_name": { "type": "string" },
          "telegram_username": { "type": "string" },
          "role": { "type": "string" },
          "github_login": { "type": "string" },
          "gitlab_login": { "type": "string" }
        }
      },
      "TmaAdminScenario": {
        "type": "object",
        "required": ["id", "name", "enabled", "schedule"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "enabled": { "type": "boolean" },
          "schedule": { "type": "string" },
          "last_run_at": { "type": "string", "format": "date-time" }
        }
      },
      "TmaAdminScenarioPatchRequest": {
        "type": "object",
        "required": ["enabled"],
        "properties": {
          "enabled": { "type": "boolean" }
        }
      },
      "TmaAdminScenarioRun": {
        "type": "object",
        "required": ["id", "scenario_id", "status", "started_at"],
        "properties": {
          "id": { "type": "string" },
          "scenario_id": { "type": "string" },
          "status": { "type": "string" },
          "started_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": "string", "format": "date-time" },
          "error": { "type": "string" }
        }
      },
      "TmaAdminAuditEntry": {
        "type": "object",
        "required": ["id", "actor_email", "actor_telegram_id", "action", "target_kind", "target_id", "details", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "actor_email": { "type": "string" },
          "actor_telegram_id": { "type": "integer", "format": "int64" },
          "action": { "type": "string" },
          "target_kind": { "type": "string" },
          "target_id": { "type": "string" },
          "details": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "TmaMeetingCreateRequest": {
        "type": "object",
        "required": ["dept", "type", "date", "start", "end", "recurrence", "participants"],
        "properties": {
          "dept":  { "type": "string" },
          "type":  { "type": "string" },
          "host":  { "type": "string" },
          "date":  { "type": "string", "description": "YYYY-MM-DD" },
          "start": { "type": "string", "description": "HH:MM" },
          "end":   { "type": "string", "description": "HH:MM" },
          "recurrence": { "type": "string", "enum": ["once", "daily", "weekly", "custom", "monthly"] },
          "desc":  { "type": "string" },
          "participants": { "type": "array", "items": { "type": "string", "format": "email" } },
          "recurrence_until": { "type": "string", "format": "date" },
          "recurrence_days": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 7 }
          }
        }
      }
    }
  }
}
