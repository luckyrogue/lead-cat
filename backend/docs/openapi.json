    "/api/tma/conflicts": {
      "post": {
        "operationId": "tmaConflicts",
        "tags": ["tma"],
        "summary": "Cross-participant conflict warning",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TmaConflictsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conflicts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["occurrences"],
                  "properties": {
                    "occurrences": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/TmaOccurrenceConflicts" }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid range / participants",
