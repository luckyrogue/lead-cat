{
  "openapi": "3.1.0",
  "info": {
    "title": "Lead Cat API",
    "version": "1.0.0",
    "description": "TMA-facing endpoints and health check for frontend codegen."
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_health_get",
        "tags": ["health"],
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Dependencies healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          },
          "503": {
            "description": "Dependency down",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/tma": {
      "post": {
        "operationId": "tma_auth_post",
        "tags": ["auth"],
        "summary": "Exchange Telegram initData for TMA JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TmaAuthRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TmaAuthResponse" }
              }
            }
          },
          "401": {
            "description": "Auth failed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TmaAuthError" }
              }
            }
          }
        }
      }
    },
    "/api/tma/me": {
      "get": {
        "operationId": "tma_me_get",
        "tags": ["tma"],
        "summary": "Current TMA user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User identity",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TmaUser" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/tma/meetings": {
      "get": {
        "operationId": "tma_meetings_get",
        "tags": ["tma"],
        "summary": "List authed user meetings",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["upcoming", "past", "all"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meetings list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TmaMeetingsResponse" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "tmaCreateMeeting",
        "tags": ["tma"],
        "summary": "Create a meeting (once or recurring series)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TmaMeetingCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created meeting",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["meeting"],
                  "properties": {
                    "meeting": { "$ref": "#/components/schemas/TmaMeeting" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid body / validation_failed / meetings_not_configured",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "409": {
            "description": "telegram_linked_to_other_account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/tma/schedule": {
      "get": {
        "operationId": "tma_schedule_get",
        "tags": ["tma"],
        "summary": "Colleague schedule (read-only)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "email" }
          },
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["upcoming", "past", "all"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meetings list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TmaMeetingsResponse" }
              }
            }
          }
        }
      }
    },
    "/api/tma/employees": {
      "get": {
        "operationId": "tma_employees_get",
        "tags": ["tma"],
        "summary": "Search employee directory",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Employees",
