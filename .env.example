# Real token from @BotFather for Telegram; leave empty in AUTH_DEV_MODE (API-only local dev)
BOT_TOKEN=
DATABASE_URL=postgres://notify:notify@localhost:5432/notify?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MASTER_ENCRYPTION_KEY=change-me-32-chars-minimum-secret

JWT_SECRET=change-me-jwt-secret-min-16-chars
JWT_ISSUER=lead-cat
JWT_TTL_HOURS=168
AUTH_DEV_MODE=true
AUTH_DEV_USER_SUB=dev-user
AUTH_DEV_EMAIL=dev@lead.cat
AUTH_OTP_LOG=true
VITE_AUTH_DEV_MODE=true

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3000

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_BASE_URL=https://gitlab.com

HTTP_ADDR=:8080
WEBAPP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
LOG_LEVEL=info
LOG_FORMAT=json
AUTO_MIGRATE=true
