{
  "name": "lead-cat",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "openapi:generate": "pnpm --filter @leadcat/api-client generate",
    "brand:sync": "pnpm --filter @leadcat/brand sync",
    "brand:generate": "pnpm --filter @leadcat/brand generate",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check --filter=./apps/*"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18"
  }
}
