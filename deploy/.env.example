# Local development template — copy to repo root: cp deploy/.env.example .env
# Production (APP_ENV=production): never set AUTH_DEV_MODE; set METRICS_TOKEN; TRUST_PROXY_HEADERS=true behind nginx.

APP_ENV=development

# Dev only — impersonate Telegram user without initData (backend + mini-app)
AUTH_DEV_MODE=true

# Required — separate from MASTER_ENCRYPTION_KEY (min 16 chars)
JWT_SECRET=local-dev-jwt-secret-min-16

# Required in production (APP_ENV=production)
METRICS_TOKEN=

# false when hitting backend directly; true behind nginx/Dokploy reverse proxy
TRUST_PROXY_HEADERS=false

BOT_TOKEN=
DATABASE_URL=postgres://notify:notify@localhost:5432/notify?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MASTER_ENCRYPTION_KEY=local-dev-encryption-key-min-16

HTTP_ADDR=:8080
WEBAPP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:8080
WEB_COOKIE_DOMAIN=
WEB_SESSION_TTL_HOURS=720
MAGIC_LINK_TTL_MINUTES=15
JWT_TTL_HOURS=168
JWT_ISSUER=lead-cat

AUTO_MIGRATE=true
CALENDAR_STUB=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

BOT_ADMIN_TELEGRAM_IDS=

# Magic-link SMTP (Mailpit via make up: localhost:1025, UI :8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=dev@lead-cat.local

# OAuth — leave blank to disable locally
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

REMINDER_EMAIL_ENABLED=false
LOG_LEVEL=info
LOG_FORMAT=console

# Mini-app browser dev only (not baked into Docker prod builds)
VITE_TMA_DEV_TG_ID=
