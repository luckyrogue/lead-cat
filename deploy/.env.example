BOT_TOKEN=
BOT_ADMIN_TELEGRAM_IDS=
DATABASE_URL=postgres://notify:notify@localhost:5432/notify?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MASTER_ENCRYPTION_KEY=change-me-32-chars-minimum-secret

JWT_SECRET=change-me-jwt-secret-min-16-chars
JWT_ISSUER=lead-cat
JWT_TTL_HOURS=168
AUTH_DEV_MODE=true
VITE_AUTH_DEV_MODE=true
# Browser-only dev (outside Telegram): numeric telegram_id from bot_users.
# Leave empty when testing via Telegram/ngrok — real initData is used automatically.
VITE_MINIAPP_DEV_TG_ID=
# Bot username without @ — for "register in the bot" deep link.
VITE_BOT_USERNAME=lead_cat_bot

HTTP_ADDR=:8080
WEBAPP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
LOG_LEVEL=info
LOG_FORMAT=json
AUTO_MIGRATE=true
CALENDAR_STUB=true
