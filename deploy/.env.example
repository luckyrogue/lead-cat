# ── Backend service ───────────────────────────────────────────────
BOT_TOKEN=
BOT_ADMIN_TELEGRAM_IDS=
DATABASE_URL=postgres://notify:notify@localhost:5432/notify?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MASTER_ENCRYPTION_KEY=change-me-32-chars-minimum-secret

JWT_SECRET=change-me-jwt-secret-min-16-chars
JWT_ISSUER=lead-cat
JWT_TTL_HOURS=168
AUTH_DEV_MODE=true

HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json
AUTO_MIGRATE=true
CALENDAR_STUB=true

# Web auth (admin dashboard). In prod set APP_BASE_URL to the admin origin and
# WEB_COOKIE_DOMAIN to the parent domain when admin/api share one.
APP_BASE_URL=http://localhost:3001
WEBAPP_URL=http://localhost:3000
WEB_COOKIE_DOMAIN=
WEB_SESSION_TTL_HOURS=168
MAGIC_LINK_TTL_MINUTES=15
# CORS only matters for cross-origin calls. With the nginx /api proxy the SPAs
# are same-origin, so this mainly covers direct/api-domain access.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# SSO providers (optional — leave empty to disable that provider).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Outbound email (magic links / invites). Local dev uses mailpit (host: mailpit, port: 1025).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Lead Cat <no-reply@lead-cat.app>

# ── SPA services (admin, mini-app) ────────────────────────────────
# nginx in each SPA container proxies /api/* to this upstream.
API_UPSTREAM=http://backend:8080
# Build-time. Leave VITE_API_URL empty so the client calls relative /api
# (served same-origin via the nginx proxy). Set only to target a separate API origin.
VITE_API_URL=
# Mini App build-time config.
VITE_BOT_USERNAME=lead_cat_bot
# Browser-only dev (outside Telegram): numeric telegram_id from bot_users. Empty in prod.
VITE_TMA_DEV_TG_ID=
