BOT_TOKEN=
BOT_ADMIN_TELEGRAM_IDS=
DATABASE_URL=postgres://notify:notify@localhost:5432/notify?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MASTER_ENCRYPTION_KEY=change-me-32-chars-minimum-secret

JWT_SECRET=change-me-jwt-secret-min-16-chars
JWT_ISSUER=lead-cat
JWT_TTL_HOURS=168
AUTH_DEV_MODE=true
AUTH_DEV_USER_SUB=dev-user
AUTH_DEV_EMAIL=dev@lead.cat
AUTH_OTP_LOG=true
VITE_AUTH_DEV_MODE=true
# Telegram Mini App local dev (only used when VITE_AUTH_DEV_MODE=true):
# the backend dev path treats init_data as a raw telegram_id, so set this to a
# telegram id that already has a bot_users row (registered via the bot once).
VITE_TMA_DEV_TG_ID=
# Bot username (without @) for the "register in the bot" deep link in the Mini App.
VITE_BOT_USERNAME=

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3000

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
