# GitHub → Settings → Secrets and variables → Actions → Secrets
#
# One Dokploy Deploy Webhook URL per application (four separate Dokploy apps).
# CI posts: {"image":"ghcr.io/<owner>/lead-cat-<service>:<sha>"}
#
# DOKPLOY_WEBHOOK_BACKEND=https://dokploy.example.com/api/deploy/...
# DOKPLOY_WEBHOOK_LANDING=https://dokploy.example.com/api/deploy/...
# DOKPLOY_WEBHOOK_ADMIN=https://dokploy.example.com/api/deploy/...
# DOKPLOY_WEBHOOK_MINI_APP=https://dokploy.example.com/api/deploy/...
